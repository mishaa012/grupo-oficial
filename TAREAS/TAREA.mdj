							"_type": "UMLNoteView",
							"_id": "note_00595",
							"_parent": {
								"$ref": "diagram_00004"
							},
							"lineColor": "#16A34A",
							"fillColor": "#F0FDF4",
							"fontColor": "#431407",
							"font": "Arial;12;0",
							"parentStyle": false,
							"left": 55,
							"top": 620,
							"width": 560,
							"height": 85,
							"text": "REGLAS DE ASIGNACIÓN\n• Solo se asigna si Camilla.estado = LIBRE.\n• Al asignar, cambia automáticamente a OCUPADA."
						},
						{
							"_type": "UMLNoteView",
							"_id": "note_00596",
							"_parent": {
								"$ref": "diagram_00004"
							},
							"lineColor": "#EA580C",
							"fillColor": "#FFF7ED",
							"fontColor": "#431407",
							"font": "Arial;12;0",
							"parentStyle": false,
							"left": 690,
							"top": 620,
							"width": 585,
							"height": 85,
							"text": "REGLAS DE LIMPIEZA Y FALLA\n• EN_LIMPIEZA y FALLA no aparecen como disponibles.\n• Al terminar la limpieza o reparación, vuelve a LIBRE."
						}
					]
				},
